{
  "name": "enterprise-mfa-service",
  "version": "1.0.0",
  "description": "Enterprise-grade Multi-Factor Authentication Service",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:integration": "jest --testPathPattern=integration",
    "test:coverage": "jest --coverage --coverageReporters=lcov",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "db:rollback": "node scripts/rollback.js",
    "type-check": "tsc --noEmit",
    "docker:build": "docker build -t enterprise-mfa-service:latest .",
    "docker:run": "docker run -p 3000:3000 enterprise-mfa-service:latest"
  },
  "keywords": [
    "mfa",
    "authentication",
    "totp",
    "2fa",
    "security"
  ],
  "author": "HamAndCheeda",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "typescript": "^5.0.0",
    "dotenv": "^16.0.3",
    "pg": "^8.9.0",
    "redis": "^4.6.5",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.0",
    "speakeasy": "^2.0.0",
    "qrcode": "^1.5.0",
    "axios": "^1.3.4",
    "express-rate-limit": "^6.7.0",
    "winston": "^3.8.2",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "joi": "^17.9.1",
    "uuid": "^9.0.0",
    "moment": "^2.29.4"
  },
  "devDependencies": {
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.0",
    "@types/node": "^18.15.10",
    "@types/speakeasy": "^2.0.8",
    "@typescript-eslint/eslint-plugin": "^5.59.1",
    "@typescript-eslint/parser": "^5.59.1",
    "eslint": "^8.39.0",
    "jest": "^29.5.0",
    "ts-jest": "^29.1.0",
    "ts-node-dev": "^2.0.0",
    "prettier": "^2.8.8",
    "supertest": "^6.3.3",
    "@types/supertest": "^2.0.12"
  }
}
